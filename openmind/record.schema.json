{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenMind observed guardrail failure record",
  "type": "object",
  "required": [
    "case_id",
    "provider",
    "model",
    "observed_at",
    "test_type",
    "authorized_scope",
    "input_transcript",
    "model_output",
    "expected_boundary",
    "observed_outcome",
    "evidence_status"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "openai",
        "anthropic",
        "google",
        "other"
      ]
    },
    "model": {
      "type": "string"
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "test_type": {
      "enum": [
        "direct_instruction_conflict",
        "embedded_prompt_injection",
        "role_persona",
        "context_manipulation",
        "encoding",
        "refusal_consistency",
        "other"
      ]
    },
    "authorized_scope": {
      "type": "string",
      "minLength": 1
    },
    "input_transcript": {
      "type": "string",
      "minLength": 1
    },
    "model_output": {
      "type": "string",
      "minLength": 1
    },
    "expected_boundary": {
      "type": "string",
      "minLength": 1
    },
    "observed_outcome": {
      "enum": [
        "held_boundary",
        "partial_boundary_failure",
        "boundary_failure",
        "over_refusal",
        "inconclusive"
      ]
    },
    "impact": {
      "type": "string"
    },
    "reproduction_count": {
      "type": "integer",
      "minimum": 1
    },
    "environment": {
      "type": "string"
    },
    "evidence_status": {
      "enum": [
        "raw_transcript_saved",
        "independently_reproduced",
        "vendor_disclosed",
        "unverified"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
