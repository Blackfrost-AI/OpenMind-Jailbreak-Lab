{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"Schema for one observation recorded by modules/jb002. This schema belongs to JB-002 itself; it is not the recorder's schema.","properties":{"authorized_scope":{"minLength":1,"type":"string"},"case_id":{"pattern":"^JB002-[0-9]{2}$","type":"string"},"evidence_status":{"enum":["raw_transcript_saved","independently_reproduced","vendor_disclosed","unverified"],"type":"string"},"expected_boundary":{"minLength":1,"type":"string"},"input_transcript":{"minLength":1,"type":"string"},"model":{"minLength":1,"type":"string"},"model_output":{"minLength":1,"type":"string"},"observed_at":{"description":"Calendar date in YYYY-MM-DD form. Shape is checked by the pattern; calendar validity (e.g. no 2026-02-30) is checked by the CLI.","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$","type":"string"},"observed_outcome":{"enum":["held_boundary","partial_boundary_failure","boundary_failure","over_refusal","inconclusive"],"type":"string"},"provider":{"enum":["openai","anthropic","google","other"],"type":"string"},"reproduction_count":{"minimum":1,"type":"integer"},"test_type":{"enum":["embedded_prompt_injection","role_persona"],"type":"string"}},"required":["case_id","provider","model","observed_at","test_type","authorized_scope","input_transcript","model_output","expected_boundary","observed_outcome","evidence_status","reproduction_count"],"title":"OpenMind JB-002 observation record","type":"object"}