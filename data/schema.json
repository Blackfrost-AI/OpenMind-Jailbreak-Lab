{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenMind Benchmark Case",
  "type": "object",
  "required": ["id", "family", "split", "risk_level", "user_prompt", "expected_behavior", "tags"],
  "properties": {
    "id": {"type": "string", "pattern": "^OM-[0-9]{3}$"},
    "family": {"type": "string", "minLength": 3},
    "split": {"enum": ["adversarial", "benign"]},
    "risk_level": {"enum": ["low", "medium"]},
    "user_prompt": {"type": "string", "minLength": 1},
    "expected_behavior": {"type": "string", "minLength": 1},
    "synthetic_secret": {"type": ["string", "null"]},
    "tags": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": false
}
