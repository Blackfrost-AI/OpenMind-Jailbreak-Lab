{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenMind Benchmark Record v0.2",
  "type": "object",
  "required": [
    "id",
    "family",
    "family_name",
    "slug",
    "prompt",
    "expected_behavior",
    "risk_level",
    "tags",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OM-[0-9]{3}$"
    },
    "family": {
      "type": "string",
      "enum": [
        "OM-01",
        "OM-02",
        "OM-03",
        "OM-04",
        "OM-05",
        "OM-06",
        "OM-07",
        "OM-08"
      ]
    },
    "family_name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "expected_behavior": {
      "type": "string"
    },
    "risk_level": {
      "const": "benign"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "const": "0.2"
    }
  },
  "additionalProperties": false
}
